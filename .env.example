SECRET_KEY=cambia-esta-clave
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,IP_PUBLICA_EC2

# Sin DB_ENGINE se usa SQLite (desarrollo local)
DB_ENGINE=mysql
DB_NAME=sgr_laserena
DB_USER=sgr_user
DB_PASSWORD=CLAVE_DE_LA_BASE
DB_HOST=127.0.0.1
DB_PORT=3306

# Ruta donde Nginx publica phpMyAdmin (ver deploy/nginx.conf)
PHPMYADMIN_URL=/phpmyadmin/

# Solo si el sitio tiene certificado HTTPS
HTTPS=False

# Con Nginx delante, Nginx entrega las evidencias (por defecto True si DEBUG=False)
# MEDIA_X_ACCEL=True

# Recuperación de contraseña por correo.
# Demo: los correos quedan como archivos en correos_enviados/ (no requiere SMTP).
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/var/www/negocio/correos_enviados
# Producción con SMTP (por ejemplo Gmail con contraseña de aplicación):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=cuenta@gmail.com
# EMAIL_HOST_PASSWORD=CONTRASENA_DE_APLICACION
DEFAULT_FROM_EMAIL=SGR La Serena <no-responder@laserena.cl>
# Vigencia del enlace de recuperación, en segundos
PASSWORD_RESET_TIMEOUT=3600
